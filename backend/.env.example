# --- Database ---
# Prisma / NestJS connection string. Never hard-code this in source files.
# Development on your machine: host is localhost and the port matches POSTGRES_PORT.
# Example if Postgres is on 5433: postgresql://booknest:booknest@localhost:5433/booknest
# Docker Compose app service (later phase): host is "db", port 5432 inside the network.
DATABASE_URL=postgresql://booknest:booknest@localhost:5432/booknest

# Used by automated tests. The docker init script creates this database on first volume start.
# Test setup also creates it if missing.
DATABASE_URL_TEST=postgresql://booknest:booknest@localhost:5432/booknest_test

# --- HTTP ---
# NestJS listen port. Frontend expects 4000.
PORT=4000

# Allowed CORS origin. Credentials (refresh cookie) require an explicit origin, not "*".
FRONTEND_ORIGIN=http://localhost:3000

# --- JWT ---
# Short-lived access token secret. Generate a new value with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-hex-string

# Long-lived refresh token secret. Generate a different value the same way.
JWT_REFRESH_SECRET=replace-with-a-different-long-random-hex-string

# Access token lifetime (15 minutes). Refresh token lifetime (7 days).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Refresh cookie ---
# SameSite=Lax is a good default for same-site local/dev. Use "none" only with HTTPS + Secure.
# Set COOKIE_SECURE=true in production (HTTPS). false is required for local http://localhost.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- Node ---
NODE_ENV=development

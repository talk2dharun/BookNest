# ==========================================
# BookNest Environment Configuration (.env.example)
# Copy this file to .env before starting the application.
# ==========================================

# Database host port mapping for PostgreSQL container (default: 5432; use 5433 if 5432 is already in use locally)
POSTGRES_PORT=5432

# Prisma and backend PostgreSQL connection string
DATABASE_URL=postgresql://booknest:booknest@localhost:5432/booknest

# Test database connection string used by automated test runner
DATABASE_URL_TEST=postgresql://booknest:booknest@localhost:5432/booknest_test

# HTTP listen port for NestJS backend API
PORT=4000

# Allowed CORS origin and client URL for frontend web app
FRONTEND_ORIGIN=http://localhost:3000

# Browser-facing backend API URL used by Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Secret key used to sign short-lived JWT access tokens (generate with crypto.randomBytes(64).toString('hex'))
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-hex-string

# Secret key used to HMAC-hash refresh tokens (generate with crypto.randomBytes(64).toString('hex'))
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret-hex-string

# Access token expiration duration (e.g., 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token expiration duration (e.g., 7d, 30d)
JWT_REFRESH_EXPIRES_IN=7d

# SameSite policy for HTTP-only refresh cookie ('lax', 'strict', or 'none')
COOKIE_SAMESITE=lax

# Secure flag for refresh cookie (set to 'false' for local HTTP development, 'true' for HTTPS production)
COOKIE_SECURE=false

# Node runtime environment mode ('development', 'test', or 'production')
NODE_ENV=development
